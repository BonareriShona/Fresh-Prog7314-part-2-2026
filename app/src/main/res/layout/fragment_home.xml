<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- ===================== GREETING ===================== -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/greeting"
            android:textAppearance="@style/TextAppearance.ShelaStudio.Headline"
            app:layout_constraintEnd_toStartOf="@id/ivBell"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGreetingSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:text="@string/greeting_sub"
            android:textAppearance="@style/TextAppearance.ShelaStudio.BodyMuted"
            app:layout_constraintEnd_toStartOf="@id/ivBell"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_home"
            app:tint="@color/chocolate_brown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvGreeting" />

        <!-- ===================== WEATHER CARD ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvWeather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/chocolate_brown"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGreetingSub">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvWeatherLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Johannesburg · Today"
                    android:textColor="@color/soft_pink"
                    android:textAppearance="@style/TextAppearance.ShelaStudio.Caption"
                    app:layout_constraintEnd_toStartOf="@id/tvWeatherTemp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvWeatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°C"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvWeatherDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:text="Loading weather..."
                    android:textColor="@color/white"
                    android:textAppearance="@style/TextAppearance.ShelaStudio.Body"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWeatherLocation" />

                <TextView
                    android:id="@+id/tvViewOutfitsArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/view_outfits_arrow"
                    android:textColor="@color/soft_pink"
                    android:textAppearance="@style/TextAppearance.ShelaStudio.Label"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWeatherDesc" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== RECOMMENDED OUTFIT ===================== -->
        <TextView
            android:id="@+id/tvRecommendedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/recommended_outfit"
            android:textAppearance="@style/TextAppearance.ShelaStudio.Subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvWeather" />

        <TextView
            android:id="@+id/tvRecommendedSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/for_today"
            android:textAppearance="@style/TextAppearance.ShelaStudio.Caption"
            app:layout_constraintBottom_toBottomOf="@id/tvRecommendedTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvRecommendedTitle" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvRecommendedOutfit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecommendedTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@color/soft_pink_light">

                    <ImageView
                        android:id="@+id/ivRecommendedTop"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/ivRecommendedBottom"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/ivRecommendedShoes"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/tvNoOutfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="No outfit yet — create one!"
                        android:textAppearance="@style/TextAppearance.ShelaStudio.Caption"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRecommendedName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.ShelaStudio.Body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRecommendedMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.ShelaStudio.Caption" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewOutfit"
                        style="@style/Widget.ShelaStudio.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:text="@string/view_outfit"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== QUICK ACTIONS ===================== -->
        <TextView
            android:id="@+id/tvQuickActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/quick_actions"
            android:textAppearance="@style/TextAppearance.ShelaStudio.Subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvRecommendedOutfit" />

        <LinearLayout
            android:id="@+id/llQuickActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuickActions">

            <LinearLayout
                android:id="@+id/qaAddItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xs">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@color/soft_pink"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_create"
                        app:tint="@color/chocolate_brown" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/add_item"
                    android:textAppearance="@style/TextAppearance.ShelaStudio.Caption"
                    android:textColor="@color/dark_brown_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qaCreateOutfit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xs">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@color/soft_pink"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_closet"
                        app:tint="@color/chocolate_brown" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/create_outfit"
                    android:textAppearance="@style/TextAppearance.ShelaStudio.Caption"
                    android:textColor="@color/dark_brown_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qaLogOutfit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xs">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@color/soft_pink"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_community"
                        app:tint="@color/chocolate_brown" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/log_outfit"
                    android:textAppearance="@style/TextAppearance.ShelaStudio.Caption"
                    android:textColor="@color/dark_brown_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/qaTripPlanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xs">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@color/soft_pink"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/chocolate_brown" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/trip_planner"
                    android:textAppearance="@style/TextAppearance.ShelaStudio.Caption"
                    android:textColor="@color/dark_brown_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== WARDROBE SNAPSHOT ===================== -->
        <TextView
            android:id="@+id/tvSnapshotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/wardrobe_snapshot"
            android:textAppearance="@style/TextAppearance.ShelaStudio.Subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llQuickActions" />

        <TextView
            android:id="@+id/tvViewInsights"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_insights"
            android:textColor="@color/chocolate_brown"
            android:textAppearance="@style/TextAppearance.ShelaStudio.Label"
            app:layout_constraintBottom_toBottomOf="@id/tvSnapshotTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvSnapshotTitle" />

        <LinearLayout
            android:id="@+id/llSnapshot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSnapshotTitle">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/soft_pink_light"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/tvStatItems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.ShelaStudio.Subtitle"
                        android:textColor="@color/chocolate_brown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Items"
                        android:textAppearance="@style/TextAppearance.ShelaStudio.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/soft_pink_light"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/tvStatOutfits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.ShelaStudio.Subtitle"
                        android:textColor="@color/chocolate_brown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Outfits"
                        android:textAppearance="@style/TextAppearance.ShelaStudio.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/soft_pink_light"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/tvStatTimesWorn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.ShelaStudio.Subtitle"
                        android:textColor="@color/chocolate_brown" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Worn"
                        android:textAppearance="@style/TextAppearance.ShelaStudio.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===================== RECENT ACTIVITY ===================== -->
        <TextView
            android:id="@+id/tvRecentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/recent_activity"
            android:textAppearance="@style/TextAppearance.ShelaStudio.Subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llSnapshot" />

        <TextView
            android:id="@+id/tvViewAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_all"
            android:textColor="@color/chocolate_brown"
            android:textAppearance="@style/TextAppearance.ShelaStudio.Label"
            app:layout_constraintBottom_toBottomOf="@id/tvRecentTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvRecentTitle" />

        <TextView
            android:id="@+id/tvNoActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:padding="@dimen/spacing_md"
            android:text="@string/no_recent_activity"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.ShelaStudio.BodyMuted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecentTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm">

        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="80dp"
            android:layout_height="100dp"
            android:background="@color/soft_pink_light"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Outfit Name"
                android:textAppearance="@style/TextAppearance.ShelaStudio.Body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOccasion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Occasion"
                android:textAppearance="@style/TextAppearance.ShelaStudio.Caption" />

            <TextView
                android:id="@+id/tvReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="Why this works"
                android:textAppearance="@style/TextAppearance.ShelaStudio.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewOutfit"
                style="@style/Widget.ShelaStudio.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="@dimen/spacing_xs"
                android:paddingHorizontal="@dimen/spacing_md"
                android:text="@string/view_outfit"
                android:textSize="11sp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================ -->
    <!-- TEXT APPEARANCES                              -->
    <!-- ============================================ -->

    <style name="TextAppearance.ShelaStudio.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/playfair_display_bold</item>
        <item name="android:textColor">@color/dark_brown_text</item>
        <item name="android:textSize">@dimen/text_display</item>
    </style>

    <style name="TextAppearance.ShelaStudio.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/playfair_display_bold</item>
        <item name="android:textColor">@color/dark_brown_text</item>
        <item name="android:textSize">@dimen/text_headline</item>
    </style>

    <style name="TextAppearance.ShelaStudio.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/playfair_display_regular</item>
        <item name="android:textColor">@color/dark_brown_text</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <style name="TextAppearance.ShelaStudio.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/dark_brown_text</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <style name="TextAppearance.ShelaStudio.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/dark_brown_text</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.ShelaStudio.BodyMuted" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/muted_brown</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.ShelaStudio.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/muted_brown</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <style name="TextAppearance.ShelaStudio.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/muted_brown</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- ============================================ -->
    <!-- BUTTONS                                       -->
    <!-- ============================================ -->

    <style name="Widget.ShelaStudio.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/chocolate_brown</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_xl</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="Widget.ShelaStudio.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/soft_pink</item>
        <item name="android:textColor">@color/chocolate_brown</item>
        <item name="cornerRadius">@dimen/radius_xl</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="Widget.ShelaStudio.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/chocolate_brown</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <!-- ============================================ -->
    <!-- TEXT INPUTS                                   -->
    <!-- ============================================ -->

    <style name="Widget.ShelaStudio.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeColor">@color/input_border</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/muted_brown</item>
        <item name="android:textColorHint">@color/muted_brown</item>
    </style>

    <!-- ============================================ -->
    <!-- CARDS                                         -->
    <!-- ============================================ -->

    <style name="Widget.ShelaStudio.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/elevation_card</item>
    </style>

    <style name="Widget.ShelaStudio.Card.Pink" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/soft_pink_light</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ============================================ -->
    <!-- BOTTOM NAVIGATION                             -->
    <!-- ============================================ -->

    <style name="Widget.ShelaStudio.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

</resources>